APP_NAME="Portico"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portico
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Shared / kiosk terminal (a check-in desk): shorten SESSION_LIFETIME (e.g. 45)
# and set SESSION_EXPIRE_ON_CLOSE=true so a walk-away doesn't leave a session open.
SESSION_EXPIRE_ON_CLOSE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nightly backup (php artisan backup:database) — see README.md "Backups".
# Defaults to %USERPROFILE%/OneDrive/portico-backups if unset.
# Use forward slashes — .env treats backslashes as escape characters.
# BACKUP_DESTINATION="C:/Users/<you>/OneDrive/portico-backups"
BACKUP_RETENTION_DAYS=30
# Some MariaDB/MySQL installs don't put mysqldump.exe on PATH — set the real path.
# MYSQLDUMP_PATH="C:/Program Files/MariaDB 12.3/bin/mysqldump.exe"
# Backup filenames are "<prefix>-<date>.sql.gz". Defaults to "portico".
# BACKUP_PREFIX=yourclub

# Required outside local/testing — DatabaseSeeder throws if unset on a
# non-local `migrate:fresh --seed`. Not used for local dev, which still
# gets the test@example.com / password admin as before.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="choose-a-real-password"

# Per-install wording and identifiers — all optional, sensible defaults below.
# Where staff post a heads-up about a watchlisted member before admitting them
# (a Slack/Discord channel, a group text, …). Substituted into the admission
# warning and the check-in acknowledgement labels. Defaults to "the staff channel".
# WATCHLIST_NOTIFY_LABEL="your #members channel"
# Address of the non-login "System" user that automated grants
# (vouchers:grant-comp-rewards) are attributed to. Defaults to system@portico.internal.
# SYSTEM_USER_EMAIL="system@yourclub.example"
